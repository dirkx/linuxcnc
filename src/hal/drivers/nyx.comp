static int export_io(char *prefix, int inst_num)
{
	int i, j;
	int rc = 0;
	struct io_pins *io = hal_malloc(sizeof(struct io_pins));
	YSSC2 *y = yssc2_board(inst_num);

	yssc2_receive(y);
	io->yi16 = io->yo16 = io->yao2 = 0;

	for (i = 0; i < y->num_yio; i++) {
		uint32_t iotype = yssc2_yi(y, i) >> 24;


		if (	   iotype == YIO_TYPE_I16			// known YIO module?
			|| iotype == YIO_TYPE_O16
			|| iotype == YIO_TYPE_AO2
			|| iotype == YIO_TYPE_I32
			|| iotype == YIO_TYPE_O32P
			|| iotype == YIO_TYPE_O32N
			|| (iotype >= YIO_TYPE_MB_AI && iotype <= YIO_TYPE_MB_AO+15)
			)
		{
			rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->alarm[i]), 0,
					"%s.yio-%02d.alarm", prefix, i);
			if(rc != 0) return rc;

			rc = hal_pin_new_sint(comp_id, HAL_OUT, (io->yio_error_cnt[i]), 0,
					"%s.yio-%02d.error-cnt", prefix, i);
			if(rc != 0) return rc;
		}

		if (iotype == YIO_TYPE_I16) {		// YI16
			io->yi16 |= 1<<i;
			for (j = 0; j < 16; j++) {
				rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->in[i][j]), 0, 
					            "%s.yio-%02d.in-%02d", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->in_not[i][j]), 0,
					            "%s.yio-%02d.in-%02d-not", prefix, i, j);
				if(rc != 0) return rc;

				if (mon) {
					rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->mon[i][j]), 0,
						"%s.yio-%02d.mon-%02d", prefix, i, j);
					if(rc != 0) return rc;
				}
			}
		} else if (iotype == YIO_TYPE_I32) {		// YI32
			io->yi32 |= 1<<i;
			for (j = 0; j < 32; j++) {
				rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->in[i][j]), 0,
					            "%s.yio-%02d.in-%02x", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->in_not[i][j]), 0,
					            "%s.yio-%02d.in-%02x-not", prefix, i, j);
				if(rc != 0) return rc;

				if (mon) {
					rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->mon[i][j]), 0,
						"%s.yio-%02d.mon-%02x", prefix, i, j);
					if(rc != 0) return rc;
				}
			}
		} else if (iotype == YIO_TYPE_O16) {	// YO16
			io->yo16 |= 1<<i;
			for (j = 0; j < 16; j++) {
				rc = hal_pin_new_bool(comp_id, HAL_IN, (io->out[i][j]), 0,
					            "%s.yio-%02d.out-%02d", prefix, i, j);
				if(rc != 0) return rc;
				if (mon) {
					rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->mon[i][j]), 0,
						            "%s.yio-%02d.mon-%02d", prefix, i, j);
					if(rc != 0) return rc;
				}
			}
		} else if (iotype == YIO_TYPE_O32P) {	// YO32P
			io->yo32p |= 1<<i;
			for (j = 0; j < 32; j++) {
				rc = hal_pin_new_bool(comp_id, HAL_IN, (io->out[i][j]), 0,
					            "%s.yio-%02d.out-%02x", prefix, i, j);
				if(rc != 0) return rc;
				if (mon) {
					rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->mon[i][j]), 0,
						            "%s.yio-%02d.mon-%02x", prefix, i, j);
					if(rc != 0) return rc;
				}
				rc = hal_pin_new_real(comp_id, HAL_OUT, (io->o32p[i].i[j]), 0, "%s.yio-%02d.i-%02x", prefix, i, j);
				rc = hal_pin_new_real(comp_id, HAL_OUT, (io->o32p[i].v[j]), 0, "%s.yio-%02d.v-%02x", prefix, i, j);
			}
			rc = hal_pin_new_real(comp_id, HAL_OUT, (io->o32p[i].vb1), 0, "%s.yio-%02d.vb1", prefix, i);
			rc = hal_pin_new_real(comp_id, HAL_OUT, (io->o32p[i].vb2), 0, "%s.yio-%02d.vb2", prefix, i);
			rc = hal_pin_new_real(comp_id, HAL_OUT, (io->o32p[i].t1), 0, "%s.yio-%02d.t1", prefix, i);
			rc = hal_pin_new_real(comp_id, HAL_OUT, (io->o32p[i].t2), 0, "%s.yio-%02d.t2", prefix, i);
			rc = hal_pin_new_sint(comp_id, HAL_IN,  (io->o32p[i].raw), 0, "%s.yio-%02d.raw", prefix, i);
			rc = hal_pin_new_bool(comp_id, HAL_IN,  (io->o32p[i].pulldown), 0, "%s.yio-%02d.pull-down", prefix, i);
			if(rc != 0) return rc;

		} else if (iotype == YIO_TYPE_O32N) {	// YO32N
			io->yo32n |= 1<<i;
			for (j = 0; j < 32; j++) {
				rc = hal_pin_new_bool(comp_id, HAL_IN, (io->out[i][j]), 0, "%s.yio-%02d.out-%02x", prefix, i, j);
				if(rc != 0) return rc;
				if (mon) {
					rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->mon[i][j]), 0, "%s.yio-%02d.mon-%02x", prefix, i, j);
					if(rc != 0) return rc;
				}
				rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->o32n[i].open[j]), 0, "%s.yio-%02d.open-%02x", prefix, i, j);
				rc = hal_pin_new_bool(comp_id, HAL_OUT, (io->o32n[i].oc[j]), 0, "%s.yio-%02d.oc-%02x", prefix, i, j);
			}
			rc = hal_pin_new_bool(comp_id, HAL_IN,  (io->o32n[i].pulldown), 0, "%s.yio-%02d.pull-down", prefix, i);
			rc = hal_pin_new_bool(comp_id, HAL_OUT,  (io->o32n[i].fault), 0, "%s.yio-%02d.fault", prefix, i);
			if(rc != 0) return rc;
/*		} else if (iotype == 3) {	// incremental encoder
			io->yenc |= 1<<i;
			rc = hal_pin_new_sint(comp_id, HAL_OUT, (io->enc[i]), 0, "%s.encoder-%02d.counts", prefix, i);
			if(rc != 0) return rc;
			rc = hal_param_bit_newf(comp_id, HAL_RW, (io->x4[i]), 0, "%s.encoder-%02d.x4-mode", prefix, i);
			if(rc != 0) return rc;
*/		} else if (iotype == YIO_TYPE_AO2) {	// YAO2
			io->yao2 |= 1<<i;
			for (j = 0; j < 2; j++) {
				rc = hal_pin_new_real(comp_id, HAL_IN, (io->ao2[i][j].value), 0, "%s.yio-%02d.dac-%02d.value", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_real(comp_id, HAL_IN, (io->ao2[i][j].bias), 0, "%s.yio-%02d.dac-%02d.bias", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_real(comp_id, HAL_IN, (io->ao2[i][j].scale), 0, "%s.yio-%02d.dac-%02d.scale", prefix, i, j);
				if(rc != 0) return rc;
				hal_set_real(*(io->ao2[i][j].scale) ,1.0);
				hal_set_real(*(io->ao2[i][j].bias), 0.0);
				hal_set_real(*(io->ao2[i][j].value), 0.0);

				rc = hal_pin_new_bool(comp_id, HAL_IO,     (io->ao2[i][j].index_enable), 0, "%s.yio-%02d.encoder-%02d.index-enable", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_real(comp_id, HAL_OUT,  (io->ao2[i][j].pos), 0, "%s.yio-%02d.encoder-%02d.pos", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_real(comp_id, HAL_OUT,  (io->ao2[i][j].velocity), 0, "%s.yio-%02d.encoder-%02d.velocity", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_real(comp_id, HAL_OUT,  (io->ao2[i][j].velocity_rps), 0, "%s.yio-%02d.encoder-%02d.velocity-rps", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_param_new_real(comp_id, HAL_RW, &(io->ao2[i][j].cpr), 0, "%s.yio-%02d.encoder-%02d.cpr", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_param_new_real(comp_id, HAL_RW, &(io->ao2[i][j].min_speed_estimate), 0, "%s.yio-%02d.encoder-%02d.min-speed-estimate", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_sint(comp_id, HAL_OUT,    (io->ao2[i][j].counts), 0, "%s.yio-%02d.encoder-%02d.counts", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_bool(comp_id, HAL_OUT,    (io->ao2[i][j].in_00), 0, "%s.yio-%02d.in-%02d", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_bool(comp_id, HAL_OUT,    (io->ao2[i][j].in_00_not), 0, "%s.yio-%02d.in-%02d-not", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_pin_new_bool(comp_id, HAL_IN,     (io->ao2[i][j].out_00), 0, "%s.yio-%02d.out-%02d", prefix, i, j);
				if(rc != 0) return rc;
				rc = hal_param_new_bool(comp_id, HAL_RW,   &(io->ao2[i][j].x4_mode), 0, "%s.yio-%02d.encoder-%02d.x4-mode", prefix, i, j);
				if(rc != 0) return rc;

				io->ao2[i][j].count = 0;
				hal_set_real(io->ao2[i][j].cpr, 10000);
				hal_set_real(io->ao2[i][j].min_speed_estimate ,1.0);
				hal_set_bool(io->ao2[i][j].x4_mode, 1);
				io->ao2[i][j].enc_chg = -1;
			}

		} else if (iotype >= YIO_TYPE_MB_AI && iotype <= YIO_TYPE_MB_AI+15) {
			int nai = iotype - YIO_TYPE_MB_AI+1;
			io->mai |= 1<<i;
			for (j = 0; j < nai; ++j) {
				rc = hal_pin_new_real(comp_id, HAL_OUT, (io->maio[i].value[j]), 0, "%s.yio-%02d.adc-%02d.value", prefix, i, j);
				rc = hal_pin_new_real(comp_id, HAL_IN,  (io->maio[i].scale[j]), 0, "%s.yio-%02d.adc-%02d.scale", prefix, i, j);
				rc = hal_pin_new_real(comp_id, HAL_IN,  (io->maio[i].bias[j]), 0, "%s.yio-%02d.adc-%02d.bias", prefix, i, j);
				hal_set_real(*io->maio[i].value[j], 0.0);
				hal_set_real(*io->maio[i].scale[j], 0.001);
				hal_set_real(*io->maio[i].bias[j], 0.0);
				if(rc != 0) return rc;
			}

			io->maio[i].nai = nai;
			io->maio[i].nao = 0;

		} else if (iotype >= YIO_TYPE_MB_AO && iotype <= YIO_TYPE_MB_AO+15) {
			int nao = iotype - YIO_TYPE_MB_AO+1;
			io->mai |= 1<<i;
			for (j = 0; j < nao; ++j) {
				rc = hal_pin_new_real(comp_id, HAL_IN, (io->maio[i].value[j]), 0, "%s.yio-%02d.dac-%02d.value", prefix, i, j);
				rc = hal_pin_new_real(comp_id, HAL_IN, (io->maio[i].scale[j]), 0, "%s.yio-%02d.dac-%02d.scale", prefix, i, j);
				rc = hal_pin_new_real(comp_id, HAL_IN, (io->maio[i].bias[j]), 0, "%s.yio-%02d.dac-%02d.bias", prefix, i, j);
				hal_set_real(*io->maio[i].value[j], 0.0);
				hal_set_real(*io->maio[i].scale[j], 0.001);
				hal_set_real(*io->maio[i].bias[j], 0.0);
				if(rc != 0) return rc;
			}

			io->maio[i].nai = 0;
			io->maio[i].nao = nao;
		}
	}

	y->io = io;

	return 0;
}

