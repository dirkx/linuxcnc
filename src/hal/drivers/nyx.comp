// calculate event frequency
// 1125 hz ~= 1024 hz = 256 * 4 * 4 = 4 sec;
int freq(YSSC2 *y, int event)
{
	if (y->freq.i & 0xff) {
		y->freq.bucket += event;
	} else {
		y->freq.j = y->freq.i >> 8;
		y->freq.sum -= y->freq.b[y->freq.j];
		y->freq.sum += (y->freq.b[y->freq.j] = y->freq.bucket + event);
		y->freq.bucket = 0;
	}
	++y->freq.i;
	y->freq.i &= 0xfff;

	return y->freq.sum;
}

#include <rtapi_math.h>

FUNCTION(_)
{
	// calling nyx.0 instead of nyx.0.rd, motion-command-handler, motion-controller, nyx.0.wr introduces 1 servo cycle latency
	rd(__comp_inst, period);
	wr(__comp_inst, period);
}

FUNCTION(rd)
{
	if (v_seq & ((1<<cycle[v_boardno]) - 1)) return;	// skip
	YSSC2 *y = yssc2_board(v_boardno);
	if (y == NULL) return;
/*
	if (!enable) {
		phase = 0;
		insync = 0;
		ready = 0;
		return;
	}
*/

//	long long int c = rtapi_get_clocks();
//	jitter = (c - y->prev_clock) / 2.8 / 22.222222;
//	y->prev_clock = c;

	yssc2_receive(y);	// should be the very first routine

	int insync;
	phase_set( yssc2_irq_time_us(y) * 45.0);
	insync = (yssc2_fb_seq(y) & YS_INSYNC) != 0;

	if (pll_limit > 0) {
		y->pll_corr = -yssc2_irq_time_us(y) * 1000;
		if (y->pll_corr > pll_limit) y->pll_corr = pll_limit;
		if (y->pll_corr < -pll_limit) y->pll_corr = -pll_limit;
	} else {
		y->pll_corr = 0;
	}
	rtapi_task_pll_set_correction(y->pll_corr);

	if (y->num_dbg > 0) dbg0_set( y->dp_dbg[0] );
	if (y->num_dbg > 1) dbg1_set( y->dp_dbg[1] );
	if (y->num_dbg > 2) dbg2_set( y->dp_dbg[2] );
	dbg3_set( yssc2_fb_seq(y));

#define MAX_GLITCH 5
#define MAX_ERRORS 5

	if (freq(y, !insync) == 0) y->errors_shown = 0;	// reset message inhibit
	if (y->initial_delay < 3000000) ++y->initial_delay;

	if (insync) {
		if (!ready) {
			if(y->initial_delay > 3000000000 / period * 5) {
				if (++y->errors_shown < MAX_ERRORS) {
					rtapi_print_msg(RTAPI_MSG_ERR, "nyx.%d: sync glitch, %d ticks\n", y->no, glitch_len);
				} else if (y->errors_shown == MAX_ERRORS) {
					rtapi_print_msg(RTAPI_MSG_ERR, "nyx.%d: sync glitch, %d ticks. check servo thread period!\n", y->no, glitch_len);
				} else {
					y->errors_shown = MAX_ERRORS + 1;
				}
			}
			ready_set( 1 );
		}
		glitch_len = 0;
	} else {
		if (++glitch_len >= MAX_GLITCH) {
			ready_set( 0 );
		}
		error_cnt_set(error_cnt + 1 );
	}

	{
		if (!ready && glitch_len == 3000000000 / period * 5 && y->errors_shown < MAX_ERRORS) {
			rtapi_print_msg(RTAPI_MSG_ERR, "nyx.%d: board firmware NOT READY\n", y->no);
			++y->errors_shown;
		}
		y->was_ready = ready;
	}

	yssc2_process(y);	// state machine, request servo data: absolute origin, encoder res, etc

	// parse received feedback data
	int a;
	for (a = 0; a < yssc2_axes(y); a++) {
		if (ready && yssc2_online(y, a)) {
			if (yssc2_feedback_res(y, a) == 0) continue;

			if (yssc2_has_fb(y)) {
				if (yssc2_valid(y, a)) {

					{
						int state = y->amp[a].zsm;
						switch (state) {
						case ZSM_IDLE:
							if (servo_index_enable(a)) {
								yssc2_reset_z(y, a, 1);
///								y->amp[a].index_req_pos = servo_counts_cmd(a);
								state = ZSM_SAVE_Z;
							} else {
		idle:						yssc2_reset_z(y, a, 0);
								state = ZSM_IDLE;
							}
							break;
						case ZSM_SAVE_Z:
							state = ZSM_INDEX_REQ;
							// fall thru
						case ZSM_INDEX_REQ:
							if (servo_index_enable(a)) {
								if (!yssc2_z_passed(y, a)) {
									yssc2_reset_z(y, a, 0);
									state = ZSM_WAIT_Z;
								} else  {
									yssc2_reset_z(y, a, 1);
								}
							} else
								goto idle;
							break;
						case ZSM_WAIT_Z:
							if (servo_index_enable(a)) {
								if (yssc2_z_passed(y, a)) {
									int delay = servo_z_offs_delay(a);
									if (delay < 0) delay = 0;
									if (delay > ZSM_SET_OFFS - ZSM_WAIT_OFFS) delay = ZSM_SET_OFFS - ZSM_WAIT_OFFS;
									state = ZSM_SET_OFFS - delay;
								}
							} else
								goto idle;
							break;
						case ZSM_SET_OFFS:
							if (servo_index_enable(a)) {
								servo_origin_set(a, y->amp[a].index_req_pos + yssc2_z_offs(y, a));
								servo_index_enable_set(a, 0);
							} else
								goto idle;
							break;
						default: state++; break;
						}
						y->amp[a].zsm = state;
//						servo_dbg_set(a, state);
					}

					int64_t fb = yssc2_pos_fb(y, a);
					servo_counts_set(a, fb);
					servo_counts_hi_set(a, fb>>32);
					fb -= servo_origin(a);

					servo_dbg_set(a, yssc2_rx_time(y, a));	// feedback packet rx time
					servo_online_set(a, 1);
					servo_offline_set(a, 0);
					servo_ready_set(a,  yssc2_ready(y, a));
					servo_enabled_set(a,  yssc2_enabled(y, a));
					servo_warning_set(a,  yssc2_warning(y, a));
					servo_alarm_set(a,  yssc2_alarm(y, a));
					servo_alarm_code_set(a,  yssc2_alarm_code(y, a));
					servo_zero_speed_set(a,  yssc2_zero_speed(y, a));
					servo_in_position_set(a,  yssc2_in_position(y, a));
					servo_at_speed_set(a,  yssc2_at_speed(y, a));
					servo_spindle_oriented_set(a,  yssc2_oriented(y, a));
					servo_spindle_orienting_set(a,  yssc2_orienting(y, a));
					servo_spindle_in_lcoil_set(a,  yssc2_in_lcoil(y, a));
					servo_spindle_in_coil_change_set(a,  yssc2_in_coil_ch(y, a));

//					if (!yssc2_zero_speed(y, a) && servo_undroop(a)) fb += yssc2_droop(y, a);
//					if (servo_undroop(a)) fb += yssc2_droop(y, a);
					if (servo_undroop(a) && servo_enable(a))
						fb = ((FB(a).state & Y_TYPE) == Y_TYPE_FB64) ?
						((int64_t)(CMD(a).pos64)<<32) + CMD(a).pos - servo_origin(a) :
						CMD(a).pos - servo_origin(a);

					servo_pos_fb_set(a,  (fb) * servo_pos_scale(a) / yssc2_feedback_res(y, a));

//					servo_vel_fb_rps(a) = (servo_vel_fb(a) = yssc2_vel_fb(y, a) / servo_vel_scale(a)) / 60.0;
					float _fb = yssc2_vel_fb(y, a) / servo_vel_scale(a);
     					servo_vel_fb_set(a, _fb);
					servo_vel_fb_rps_set(a, _fb / 60.0);

					servo_trq_fb_set(a,  yssc2_trq_fb(y, a) / 10.0);
					servo_droop_set(a,  yssc2_droop(y, a));
					servo_torque_clamped_set(a,  yssc2_torque_clamped(y, a));
					servo_absolute_set(a,  yssc2_absolute(y, a));
					servo_abs_lost_set(a,  yssc2_abs_lost(y, a));
					servo_abs_ok_set(a,  yssc2_absolute(y, a) && !yssc2_abs_lost(y, a));

					bool b0 = yssc2_di(y, a, 0);     // J3 DI# pins
					bool b1 = yssc2_di(y, a, 1);
					bool b2 = yssc2_di(y, a, 2);

					servo_in_00_not_set(a,!b0); servo_in_00_set(a,b0);
					servo_in_01_not_set(a,!b1); servo_in_01_set(a,b1);
					servo_in_02_not_set(a,!b2); servo_in_02_set(a,b2);

					servo_z_passed_set(a,  yssc2_z_passed(y, a));
					servo_z_offs_set(a,  yssc2_z_offs(y, a));
					servo_z_revs_set(a,  yssc2_z_offs(y, a) / (double)yssc2_feedback_res(y, a));

//                                       servo_mon12(a) =
//  	                                     ((servo_mon1(a) = yssc2_mon1(y, a))<<16)
//     	                                     |(uint16_t)(servo_mon2(a) = yssc2_mon2(y, a));
					int32_t _sm = yssc2_mon1(y, a);
					int32_t _sn = yssc2_mon2(y, a);
                                        servo_mon1_set(a,_sm);
                                        servo_mon2_set(a,_sn);
					servo_mon12_set(a, (_sm<<16) |((uint16_t)_sn));
				} else {
					servo_dbg_set(a, 0);
					servo_error_cnt_set(a, servo_error_cnt(a) + 1);
				}
			}

		} else {
			servo_online_set(a, 0);
			servo_offline_set(a, 1);
			servo_ready_set(a, 0);
			servo_enabled_set(a, 0);
			servo_alarm_set(a, 1);
			servo_alarm_code_set(a, 0);
			servo_absolute_set(a, 0);
			servo_abs_lost_set(a, 1);
			servo_abs_ok_set(a, 0);
		//	yssc2_power(y, a, 0);	// the controller will do that
		//	yssc2_enable(y, a, 0);
		}
	}

#define MAXI 1500000000

	for (a = 0; a < y->num_enc; a++) {
		int c;

		if (yssc2_index_falling(y, a)) encoder_index_enable_set(a, 0);
		yssc2_index_req(y, a, encoder_index_enable(a));	// rising

		int cpr = encoder_cpr(a);
		double min_spd = encoder_min_speed_estimate(a);

		if (cpr == 0) cpr = 1;
		if (min_spd < 0.001) min_spd = 0.001;

		c = yssc2_enc(y, a);
		if (!encoder_x4_mode(a)) c = (c + 2) / 4;
		if (enc_changed[a] >= 0) {
			if (c != encoder_counts(a)) {
				int d = c - encoder_counts(a);
				if (d > -MAXI && d < MAXI) {      // just ignore integer overflow
					double v = d * 60 / fperiod / cpr / (enc_changed[a] + 1); // rpm
					if (fabs(v) < min_spd) v = 0.0;
					encoder_velocity_set(a, v);
					encoder_velocity_rps_set(a, v / 60);
				}
				enc_changed[a] = 0;
			} else {
				if (enc_changed[a] > fabs(60 / fperiod / cpr / min_spd) - 1) {
					encoder_velocity_set(a, 0.0);
					encoder_velocity_rps_set(a, 0.0);
				}
				if (enc_changed[a] < MAXI)
					enc_changed[a]++;
			}
		} else {
			enc_changed[a] = 0;
			encoder_velocity_set(a, 0.0);
			encoder_velocity_rps_set(a, 0.0);
		}
		encoder_counts_set(a, c);
		encoder_pos_set(a,c / (double)cpr);
	}

	int b;
	for (b = 0; b < y->num_gpi; b += 32) {
		uint32_t u = yssc2_gpi(y, a>>5);
		for (a = 0; a < 32 && a + b < y->num_gpi; a++) {
			in_not_set(a+b, !( u & 1));
                        in_set(a+b, u & 1);
			u >>= 1;
		}
	}

	// YIO - process received data, set output pins
	for (a = 0; a < y->num_yio; a++) {
		int n;
		uint32_t i;

		if (yio_yi16(a)) {
			i = yssc2_yi(y, a);
			for (n = 0; n < 16; n++) {
                                bool v= (i & (1<<n)) ? 1 : 0;
				yio_pin_in_not_set(a, n, !v);
                                yio_pin_in_set(a, n, v);
				if (mon) yio_pin_mon_set(a, n, v);
			}
			yio_pin_error_cnt_set(a, (i & 0x00ff0000) >> 16);
                        bool v = yio_pin_error_cnt(a) > 10;
			yio_pin_alarm_set(a, v ? 1 : 0);
		}

		if (yio_yi32(a)) {
			i = yssc2_yi2(y, a);
			for (n = 0; n < 32; n++) {
                                bool v = (i & (1<<n)) ? 1 : 0;
                                yio_pin_in_set(a, n, v);
				yio_pin_in_not_set(a, n, !v);
				if (mon) yio_pin_mon_set(a, n, v);
			}
			yio_pin_error_cnt_set(a, (yssc2_yi(y,a) & 0x00ff0000) >> 16);
			yio_pin_alarm_set(a, (yio_pin_error_cnt(a) > 10) ||
					    (yssc2_yi(y,a) & 0xc0));
		}

		if (yio_mai(a)) {	//
			uint16_t *yi = (uint16_t*)&y->dp_yi[a * y->yio_size];
			struct maio *maio = &y->io->maio[a];

			yio_pin_error_cnt_set(a, yi[1] & 0xff);
			yio_pin_alarm_set(a, yio_pin_error_cnt(a) > 10 ? 1 : 0);

			int j = 0;
			for (n = 0; n < maio->nai; n++) {
				double s = hal_get_real(*(maio->scale[n]));
				double b = hal_get_real(*(maio->bias[n]));

				uint16_t v;
				switch (j++) {
				case 0: v = *yi++;
					yi++;
					break;
				case 1: v = *yi++;
					break;
				case 2: v = *yi++;
					j = 0;
					break;
				}

				hal_set_real(*(maio->value[n]), v * s + b);
			}
		}

/*
		if (yio_yenc(a)) {
			uint16_t n = (int16_t)yssc2_yi(y, a);
			if (!yio_param_x4(a)) n = (n + 2) >> 2;
			int32_t o = yio_pin_enc(a);
			int32_t d = n - (uint16_t)o;
			if (d > 32767) o -= 0x10000;
			else if(d < -32768) o += 0x10000;
			yio_pin_enc(a, (o & 0xffff0000) + n;	// expand 16bit counter to 32 bits
		}
*/

		if (yio_yao2(a)) {
			// read encoder and gpi feedback from the YAO2, set output pins
			for (n = 0; n < 2; n++) {
				uint16_t c = (int16_t)(yssc2_yi2(y, a) >> (n * 16));
				int64_t o = yio_param_ao2(a, n, count);	// old counter
				int64_t d = c - (uint16_t)o;

				if (d > 32767) o -= 0x10000;
				else if(d < -32768) o += 0x10000;
				int64_t nc = (o & ~0xffff) + c;	// expand 16bit counter to 64 bits

				// index request was sent to the YAO2?
				if (yio_param_ao2(a, n, index_request) > 1) {
					yio_param_ao2(a, n, index_request)--;	// give time for index request to reach YAO2
				} else if (yio_param_ao2(a, n, index_request) && !(yssc2_yi(y, a) & (0x10<<2*n))) {	// was index reset?
					nc = (int16_t)nc;			// trash the high hword
					yio_param_ao2(a, n, index_request) = 0;
					yio_pin_ao2(a, n, index_enable) = 0;
				}

				int cpr = hal_get_real(yio_param_ao2(a, n, cpr));
				double min_spd = hal_get_real(yio_param_ao2(a, n, min_speed_estimate));
				int *enc_chg = &yio_param_ao2(a, n, enc_chg);

				if (cpr == 0) cpr = 1;
				if (min_spd < 0.001) min_spd = 0.001;

				if (*enc_chg >= 0) {
					d = nc - yio_param_ao2(a, n, count);
					if (d) {
						if (d > -MAXI && d < MAXI) {      // just ignore integer overflow
							double v = d * 60 / fperiod / cpr / (*enc_chg + 1); // rpm or mm/min
							if (fabs(v) < min_spd) v = 0.0;

							yio_param_ao2(a, n, velocity_filter[3]) = yio_param_ao2(a, n, velocity_filter[2]);
							yio_param_ao2(a, n, velocity_filter[2]) = yio_param_ao2(a, n, velocity_filter[1]);
							yio_param_ao2(a, n, velocity_filter[1]) = yio_param_ao2(a, n, velocity_filter[0]);
							yio_param_ao2(a, n, velocity_filter[0]) = v;

							v = (	yio_param_ao2(a, n, velocity_filter[0]) +
								yio_param_ao2(a, n, velocity_filter[1]) +
								yio_param_ao2(a, n, velocity_filter[2]) +
								yio_param_ao2(a, n, velocity_filter[3])) / 4;

							hal_set_real(yio_pin_ao2(a, n, velocity), v);
							hal_set_real(yio_pin_ao2(a, n, velocity_rps), v / 60);
						}
						*enc_chg = 0;
					} else {
						if (*enc_chg > fabs(60 / fperiod / cpr / min_spd) - 1) {
							hal_set_real(yio_pin_ao2(a, n, velocity), 0.0);
							hal_set_real(yio_pin_ao2(a, n, velocity_rps), 0.0);
						}
						if (*enc_chg < MAXI)
							++*enc_chg;
					}
				} else {
					*enc_chg = 0;
//					hal_set_real(yio_pin_ao2(a, n, velocity), 0.0);
				}

				yio_param_ao2(a, n, count) = nc;

				hal_set_sint(yio_pin_ao2(a, n, counts), yio_param_ao2(a, n, x4_mode) ? nc : (nc + 2) / 4);
				hal_set_real(yio_pin_ao2(a, n, pos), nc / (double)cpr);

                                bool v = yssc2_yi(y, a) & (1<<2*n);
				hal_set_bool(yio_pin_ao2(a, n, in_00),v);
                                hal_set_bool(yio_pin_ao2(a, n, in_00_not),!v);
			}

			i = yssc2_yi(y, a);
			yio_pin_error_cnt_set(a, (i & 0x00ff0000) >> 16);
			yio_pin_alarm_set(a, yio_pin_error_cnt(a) > 10 ? 1 : 0);
		}

		if (yio_yo16(a)) {	// output board - input pins
			i = yssc2_yi(y, a);
			yio_pin_error_cnt_set(a, (i & 0x00ff0000) >> 16);
			yio_pin_alarm_set(a, yio_pin_error_cnt(a) > 10 ? 1 : 0);
		}

		if (yio_yo32p(a)) {	// output board - input pins
			i = yssc2_yi(y, a);
			uint32_t i2 = yssc2_yi2(y, a);
			yio_pin_error_cnt_set(a, (i & 0x00ff0000) >> 16);
			yio_pin_alarm_set(a, yio_pin_error_cnt(a) > 10 ? 1 : 0);	// TODO

#define yio_pin_o32p(a,f)    	   (*(y->io->o32p[a].f))
#define yio_pin_o32p_set(a,f,v)    hal_set_real(*(y->io->o32p[a].f),v)
#define yio_pin_o32pi(a,f,n) 	   (*(y->io->o32p[a].f[n]))
#define yio_pin_o32pi_set(a,f,n,v) hal_set_real(*(y->io->o32p[a].f[n]),v)

			uint16_t v0 = (i2&0x03ff);
			uint16_t c0 = (i2&0xf800)>>11;
			uint16_t v1 = (i2&0x03ff0000)>>16;
			uint16_t c1 = (i2&0xf8000000)>>27;

			double f = 1;
			switch (i & 7) {
			case 7:
				yio_pin_o32p_set(a, t1, (774 - v0) / 2.22);
				yio_pin_o32p_set(a, t2, (774 - v1) / 2.22);
				break;
			case 5:
				yio_pin_o32p_set(a, vb1, 40.32e-3 * v0);
				yio_pin_o32p_set(a, vb2, 40.32e-3 * v1);
				break;
			case 1:
				f = yio_pin_o32p(a, raw) ? 1 : 182.92e-3;
				if (v0 < 1023) yio_pin_o32pi_set(a, i, c0, f * v0);
				if (v1 < 1023) yio_pin_o32pi_set(a, i, c1, f * v1);
				break;
			case 3:
				yio_pin_o32pi_set(a, v, c0, 40.32e-3 * v0);
				yio_pin_o32pi_set(a, v, c1, 40.32e-3 * v1);
				break;
			}
		}

		if (yio_yo32n(a)) {	// output board - input pins
			i = yssc2_yi(y, a);
			uint32_t i2 = yssc2_yi2(y, a);
			yio_pin_error_cnt_set(a, (i & 0x00ff0000) >> 16);
			yio_pin_alarm_set(a, yio_pin_error_cnt(a) > 10 ? 1 : 0);	// TODO

#define yio_pin_o32n(a,f)    hal_get_bool(*(y->io->o32n[a].f)))
#define yio_pin_o32n_set(a,f,v)    hal_set_bool(*(y->io->o32n[a].f),v)

#define yio_pin_o32ni(a,f,i) (*(y->io->o32n[a].f[i]))
#define yio_pin_o32ni_set(a,f,ii,v) hal_set_bool((*(y->io->o32n[a].f[i])),v)

			yio_pin_o32n_set(a, fault, (i & 0x80) ? 1 : 0);
			if ((i & 0x7) == 1) {
				for (n = 0; n < 32; n++)
					yio_pin_o32ni_set(a, open, n,(i2 & (1<<n)) ? 1 : 0);
			} else {
				for (n = 0; n < 32; n++)
					yio_pin_o32ni_set(a, oc, n, (i2 & (1<<n)) ? 1 : 0);
			}
		}
	}
}

FUNCTION(wr)
{
        (void)period;

	if (v_seq++ & ((1<<cycle[v_boardno]) - 1)) return;	// skip
	YSSC2 *y = yssc2_board(v_boardno);
	if (y == NULL) return;

	int a;

	// prepare servo command data
	for (a = 0; a < yssc2_axes(y); a++) {
		if (ready && yssc2_online(y, a)) {
			if (yssc2_feedback_res(y, a) == 0) continue;	// should do it in the very beginning

			// input pins
			yssc2_power(y, a, servo_power(a));
			yssc2_enable(y, a, servo_enable(a));
			yssc2_vel_ctl(y, a, servo_velocity_mode(a));
			yssc2_vel_cmd(y, a, servo_vel_cmd(a) * servo_vel_scale(a));
			{
				int64_t cmd = servo_pos_cmd(a) * yssc2_feedback_res(y, a) / servo_pos_scale(a) + servo_origin(a);
				//cmd &= 0xffffffff;
				yssc2_pos_cmd(y, a, cmd);
				servo_counts_cmd_set(a, cmd);
				servo_counts_cmd_hi_set(a, cmd>>32);
			}
			yssc2_reset_alarm(y, a, servo_reset_alarm(a));
			yssc2_limit_torque(y, a, servo_limit_torque(a));
			yssc2_forward_torque(y, a, servo_forward_torque(a) * servo_trq_scale(a));
			yssc2_reverse_torque(y, a, servo_reverse_torque(a) * servo_trq_scale(a));
			yssc2_fwd(y, a, servo_spindle_fwd(a));
			yssc2_rev(y, a, servo_spindle_rev(a));
			yssc2_orient(y, a, servo_spindle_orient(a));
			yssc2_lcoil(y, a, servo_spindle_lcoil(a));

			yssc2_do(y, a, 0, servo_out_00(a));     // J3 DO# pins
			yssc2_do(y, a, 1, servo_out_01(a));
			yssc2_do(y, a, 2, servo_out_02(a));

			yssc2_mon(y, a, servo_mon(a));

			if (y->amp[a].zsm == ZSM_SAVE_Z) {
				y->amp[a].index_req_pos = servo_counts_cmd(a);
				y->amp[a].zsm = ZSM_INDEX_REQ;
			}
		}
	}

	int b;
	for (b = 0; b < y->num_gpo; b += 32) {
		uint32_t m = 1, u = 0;
		for (a = 0; a < 32 && a + b < y->num_gpo; a++) {
			if (out(a+b)) u |= m;
			m <<= 1;
		}
		yssc2_gpo(y, b>>5, u);
	}

        for (a = 0; a < 2; a++) {
		double s = dac_scale(a) != 0 ? dac_scale(a) : 1;
                double f = dac_value(a) / s + dac_bias(a);
                if (f < 0) f = 0;
                if (f > 1) f = 1;
                yssc2_dac(y, a, f * 65535);
        }

	// YIO
	for (a = 0; a < y->num_yio; a++) {
		int n;
		uint32_t o;
		if (yio_yo16(a)) {	// output board - input pins
			for (o = n = 0; n < 16; n++) {
				if (yio_pin_out(a, n)) o |= 0x10000;
				if (mon) yio_pin_mon_set(a, n, yio_pin_out(a, n));
				o >>= 1;
			}
			yssc2_yo(y, a, o);
		}

		if (yio_yo32p(a)) {	// output board - input pins
			for (o = n = 0; n < 32; n++) {
				o >>= 1;
				if (yio_pin_out(a, n)) o |= 0x80000000;
				if (mon) yio_pin_mon_set(a, n, yio_pin_out(a, n));
			}
			yssc2_yo(y, a, o);
			yssc2_yo2(y, a, hal_get_bool(yio_pin_o32p(a, pulldown)));
		}

		if (yio_yo32n(a)) {	// output board - input pins
			for (o = n = 0; n < 32; n++) {
				o >>= 1;
				if (yio_pin_out(a, n)) o |= 0x80000000;
				if (mon) yio_pin_mon_set(a, n, yio_pin_out(a, n));
			}
			yssc2_yo(y, a, o);
			yssc2_yo2(y, a, yio_pin_o32n(a, pulldown);
		}

		if (yio_yao2(a)) {	//
			uint32_t dac = 0;
			uint32_t outs = 0;
		        for (n = 1; n >= 0; n--) {
				double s = hal_get_real(yio_pin_ao2(a, n, scale));
				if (s == 0) s = 1;
		                double f = hal_get_real(yio_pin_ao2(a, n, value)) / s + hal_get_real(yio_pin_ao2(a, n, bias));
		                if (f < -1) f = -1;
		                if (f > 1) f = 1;
				dac <<= 16;
		                dac |= (int)((f + 1) * 32767);

				outs <<= 2;
				if (yio_pin_ao2(a, n, index_enable)) {
					if (!yio_param_ao2(a, n, index_request))
						yio_param_ao2(a, n, index_request) = 4;
					outs |= 0x10;
				} else {
					yio_param_ao2(a, n, index_request) = 0;
				}
				if (yio_pin_ao2(a, n, out_00)) outs |= 1;
		        }
			yssc2_yo(y, a, outs<<16);
			yssc2_yo2(y, a, dac);

//			if (yio_param_ao2(a, n, index_request)) {

		}

		if (yio_mai(a)) {	//
			uint16_t *yo = (uint16_t*)&y->dp_yo[a * y->yio_size];
			struct maio *maio = &y->io->maio[a];

			// int j = 0;
			for (n = 0; n < maio->nao; n++) {
				double s = hal_get_real(*(maio->scale[n]));
				double b = hal_get_real(*(maio->bias[n]));
				double v = hal_get_real(*(maio->value[n]));
				if (s == 0) s = 1;
				*yo++ = v / s + b;
			}
		}
	}

	yssc2_transmit(y);
}

